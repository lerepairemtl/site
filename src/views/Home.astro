---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Facade from '../components/Facade.astro';
import { SITE } from '../config';
import { routes, t, type Lang } from '../i18n';
import { getPosts } from '../lib/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const h = s.home;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const latest = (await getPosts(lang)).slice(0, 3);
---

<Base lang={lang} title={h.title} description={h.description} altPath={routes.home[other]} current="home">
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="hero-status mono">{h.status}</p>
        <h1>{h.lead} <small>{h.leadSub}</small></h1>
        <p class="hero-body">{h.body}</p>
        <div class="btn-row">
          <a class="btn" href={SITE.instagram} rel="noopener">{h.ctaFollow}</a>
          <a class="btn ghost" href={routes.visit[lang]}>{h.ctaVisit}</a>
        </div>
      </div>
      <Facade label={h.facadeLabel} />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>{h.bandTitle}</h2>
      <p>{h.bandText}</p>
    </div>
  </section>

  <section class="section bone">
    <div class="wrap">
      <h2 class="bar-title">{h.comingTitle}</h2>
      <div class="cols">
        {
          h.cards.map((c) => (
            <div>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2 class="bar-title">{h.newsTitle}</h2>
          <PostList lang={lang} posts={latest} />
          <a class="more" href={routes.news[lang]}>
            {h.newsAll}
          </a>
        </div>
      </section>
    )
  }

  <section class="section follow">
    <div class="wrap">
      <div>
        <h2 class="bar-title">{h.followTitle}</h2>
        <p>{h.followText}</p>
      </div>
      <div class="btn-row">
        <a class="btn" href={SITE.instagram} rel="noopener">
          {h.instagram} {SITE.instagramHandle}
        </a>
        {
          SITE.discord && (
            <a class="btn ghost" href={SITE.discord} rel="noopener">
              {h.discord}
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>
