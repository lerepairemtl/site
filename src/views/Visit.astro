---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { routes, t, type Lang } from '../i18n';
import { exceptions, fmtHeure, heures, horairePublie } from '../lib/qg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const a = SITE.address;
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto' }).format(new Date());
const h = heures();
const ex = exceptions(today).slice(0, 8);
const loc = lang === 'fr' ? 'fr-CA' : 'en-CA';
const fmtEx = (x: string) => new Intl.DateTimeFormat(loc, { weekday: 'short', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(`${x}T00:00:00Z`));
---

<Base lang={lang} title={s.visit.title} description={s.visit.description} altPath={routes.visit[other]} current="visit">
  <div class="wrap">
    <header class="page-head">
      <h1>{s.visit.heading}</h1>
      <p>{s.visit.intro}</p>
    </header>
  </div>
  <div class="wrap page-body">
    <div class="info">
      <div>
        <h2>{s.visit.addressLabel}</h2>
        <address>
          {a.street}<br />
          {a.city} ({a.region}) {a.postal}
        </address>
        <a class="btn ghost" href={SITE.mapUrl} rel="noopener">{s.visit.directions}</a>
      </div>
      <div>
        <h2>{s.visit.hoursLabel}</h2>
        {horairePublie() ? (
          <>
            <dl class="hours">
              {[1, 2, 3, 4, 5, 6, 7].map((j) => { const x = h.find((y) => y.jour === j); return (<><dt>{s.visit.days[j]}</dt><dd>{x?.ouvert && x.debut && x.fin ? `${fmtHeure(x.debut, lang)} – ${fmtHeure(x.fin, lang)}` : s.visit.closed}</dd></>); })}
            </dl>
            {ex.length > 0 && <p class="meta-text"><b>{s.visit.exceptionsLabel}</b><br />{ex.map((x) => <>{fmtEx(x.date)} : {x.ouvert && x.debut && x.fin ? `${fmtHeure(x.debut, lang)} – ${fmtHeure(x.fin, lang)}` : s.visit.closed}{x.raison ? ` (${x.raison})` : ''}<br /></>)}</p>}
          </>
        ) : (
          <p>{s.visit.hours}</p>
        )}
      </div>
      <div>
        <h2>{s.visit.contactLabel}</h2>
        <p>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          <a href={SITE.instagram} rel="noopener">Instagram {SITE.instagramHandle}</a>
        </p>
      </div>
    </div>
  </div>
</Base>
