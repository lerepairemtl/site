---
import { SITE } from '../config';
import { routes, t, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  altPath: string;
  current?: RouteKey;
}
const { lang, altPath, current } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const links: { key: RouteKey; label: string }[] = [
  { key: 'news', label: s.nav.news },
  { key: 'releases', label: s.nav.releases },
  { key: 'shop', label: s.nav.shop },
  { key: 'visit', label: s.nav.visit },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={routes.home[lang]}>
      <img src={SITE.logoHeader} alt={SITE.short} width="1156" height="442" />
    </a>
    <nav class="site-nav" aria-label={s.navLabel}>
      {
        links.map((l) => (
          <a href={routes[l.key][lang]} aria-current={current === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="lang" href={altPath} hreflang={other === 'fr' ? 'fr-CA' : 'en-CA'} lang={other} aria-label={s.langSwitch}>
        {s.langSwitchShort}
      </a>
    </nav>
  </div>
</header>
