---
import Tags from './Tags.astro';
import { postPath, type Lang } from '../i18n';
import type { Post } from '../lib/posts';

interface Props {
  lang: Lang;
  posts: Post[];
}
const { lang, posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map(({ slug, entry }) => (
      <li class="post-row" data-fam={entry.data.famille}>
        <a href={postPath(lang, slug)}>
          <Tags lang={lang} data={entry.data} />
          <h3>{entry.data.title}</h3>
          {entry.data.resume && <p>{entry.data.resume}</p>}
        </a>
      </li>
    ))
  }
</ul>
