---
import Base from '../layouts/Base.astro';
import { routes, t } from '../i18n';
const s = t('fr');
const e = t('en');
---

<Base lang="fr" title={s.notFound.title} description={s.notFound.text} altPath={routes.home.en} noindex>
  <div class="wrap">
    <header class="page-head">
      <h1>{s.notFound.heading}</h1>
      <p>{s.notFound.text}</p>
      <p lang="en">{e.notFound.heading} {e.notFound.text}</p>
    </header>
    <div class="btn-row">
      <a class="btn" href={routes.home.fr}>{s.notFound.home}</a>
      <a class="btn ghost" href={routes.home.en} lang="en">{e.notFound.home}</a>
    </div>
  </div>
</Base>
